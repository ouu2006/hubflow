# 密钥模板 —— 复制成 .env 后填入真实值
#
#   cp .env.example .env        （Git Bash）
#   copy .env.example .env      （CMD）
#
# .env 已被 .gitignore 拦住，不会进仓库。
# 本文件（.env.example）只写变量名和占位符，**永远不填真 Key**。
#
# 规则见 docs/开发规范.md 第 11 节。

# ── 地图开放平台（一期：真实底图 + 虚拟车流）────────────────────
# 高德：主用（一期唯一申请方，2026-10-11 已批并实测可用）
# 控制台 https://console.amap.com/ —— 商用需企业认证（待办 T-04，归队长）
# Web 服务 Key：调 API 拉底图 / POI 用于**人工核对**（路网走 OSM，**不用于提取拓扑**）
#   · IP 白名单：**故意留空**（人工核对是本机/浏览器在做，出口 IP 不固定；
#     填死会挡住队友与演示机报 10005）。详见 work/engine/README.md §五。
#   · 数字签名 sig：**不启用**（启用后每次调用都要算签名，人工核对没法手工调）。
AMAP_WEB_KEY=your_amap_web_service_key_here
# JS API Key：渲染底图（一期大屏已改自绘 OSM，此 Key 留作底图层备用）
AMAP_JS_KEY=your_amap_js_key_here
# JS API 配套的安全密钥（2021-12-02 后申请的 JS API Key **必须**配合它使用）
AMAP_JS_SECURITY_CODE=your_amap_security_code_here

# 百度：备用 + 交叉校验（核对高德拿到的车道数与单行属性）
# **一期不申请**（2026-10-13 裁定，Issue #44）—— 一期只用高德一家；百度留作二期备选，
# 理由与要重新评估的条件见 work/engine/README.md §五「为什么一期不用百度」。
# 变量名先留着，二期授权评估通过后再填；**永远不填真 Key 进本文件**。
# 控制台 https://lbsyun.baidu.com/ —— 商用需企业认证；服务端 AK 申请时强制二选一：
# IP 校验（须填白名单）或 SN 校验（每次调用要签名），两条对人工核对都是负担。
BAIDU_WEB_KEY=your_baidu_web_service_key_here
BAIDU_JS_KEY=your_baidu_js_key_here

# 站点包声明用哪家取数：amap / baidu
# 见 stations/network.json 的 map_provider 字段
MAP_PROVIDER=amap

# ── 演示运行（可选）────────────────────────────────────────────
# 视频识别后端：mindspore（验收线） / ultralytics（旁路，仅解阻）
# 走旁路时自测报告必须写明「本次演示未验证 MindSpore 推理链路」
TRAFFIC_BACKEND=mindspore

# 数据源标记：一期恒为 true，不得改为 false
IS_SIMULATED=true

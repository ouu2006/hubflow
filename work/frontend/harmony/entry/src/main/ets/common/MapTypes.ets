/**
 * 地图档位与路线数据（Map Types + Y 字路线定义）。
 *
 * 【为什么单独放一个文件】
 * 「用哪个地图档位」和「路网长什么样、路线怎么走」是两件事：
 * 前者是**可替换的实现**（见 MapPort），后者是**业务数据**（跟随数据契约）。
 * 混在一起会导致换地图时误改业务数据、或者改数据时碰坏渲染。
 */
/** 路段等级：1畅通 2缓行 3拥堵 4严重拥堵；-1 = 数据不可用 */
export type SegmentLevel = number;
/**
 * 地图档位。
 * 一期固定 SELF_DRAW（条款限制），后续接手的人接真地图时新增一档即可，
 * 页面通过 `MAP_BACKEND` 选择，无需改页面。
 */
export const MAP_BACKEND_SELF_DRAW: string = 'self-draw';
/**
 * 【为什么只留SELF_DRAW 一档】
 * 初版还预留了 AMAP / OSM 两个常量，但一期受条款限制只能用自绘档，
 * 两者零引用。留着会让评审以为「已经支持了高德/OSM」——
 * 而高德条款明文禁止落盘与缓存，二者不可能直接用。
 * 真要新增档位时，在这里加常量并在 createRenderer() 里对应实现即可。
 */
/** 档位的中文说明，页面上要显示（评审会问「这地图哪来的」） */
export const MAP_BACKEND_DESC: string = '自绘 OSM 路网图（一期条款降级档，不落盘）';
/**
 * 路网数据的固定坐标空间（RealNet 里所有图元都落在这个范围内）。
 *
 * 【为什么必须显式声明】渲染时必须按它等比缩放，否则页面给的画布一旦比它矮，
 * 地图下半截就被裁掉 —— 表现为「每页都看不到完整地图」（本轮真踩过）。
 * 改 RealNet 里的图元坐标时，这里的两个值要同步改。
 *
 * 【680 x 880 —— 为什么换了尺寸】
 * 用户反馈「这个图片还是左右不对称，你根据数据改一下」。
 * 原空间是 340x460，窄高比例下左右两臂差 10px 就很明显；
 * 换成 680x880（宽高比更接近手机竖屏）后，中轴 x=340 两侧各 340，
 * 配对图元的横坐标之和恒为 680，对称肉眼可辨。
 */
export const MAP_NET_W: number = 680;
export const MAP_NET_H: number = 880;
/** 左右对称中轴（路网配对图元以此为基准） */
export const MAP_NET_MID_X: number = 340;

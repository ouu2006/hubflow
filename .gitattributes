# 换行符与文本属性（四人都是 Windows，统一由仓库强制，避免"整个文件都是改动"的假 diff）
# 详见 docs/开发规范.md 第 5 节

# 默认：提交时统一存 LF，检出时不自动转换
* text=auto eol=lf

# 明确按文本处理（保证跨平台 diff 干净）
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.ets   text eol=lf
*.bat   text eol=crlf

# 二进制：不做任何转换，也不要在 diff 里显示
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.pt    binary
*.ckpt  binary
